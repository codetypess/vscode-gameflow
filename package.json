{
  "name": "vscode-gameflow",
  "displayName": "GameFlow",
  "description": "在 VS Code 中分析策划需求并组织游戏 UI 页面画布。",
  "version": "0.1.0",
  "publisher": "codetypes",
  "license": "MIT",
  "engines": {
    "node": ">=20.19",
    "vscode": "^1.105.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "game-design",
    "ui-flow",
    "planning",
    "canvas"
  ],
  "activationEvents": [
    "onCustomEditor:gameflow.psdEditor",
    "onCommand:gameflow.openPsd",
    "onCustomEditor:gameflow.canvasEditor",
    "onCommand:gameflow.createCanvas"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gameflow.openPsd",
        "title": "打开 PSD 切图配置",
        "category": "GameFlow",
        "icon": "$(file-media)"
      },
      {
        "command": "gameflow.createCanvas",
        "title": "新建策划画布",
        "category": "GameFlow",
        "icon": "$(new-file)"
      }
    ],
    "customEditors": [
      {
        "viewType": "gameflow.psdEditor",
        "displayName": "GameFlow PSD 切图配置",
        "selector": [
          {
            "filenamePattern": "*.psd"
          },
          {
            "filenamePattern": "*.PSD"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "gameflow.canvasEditor",
        "displayName": "GameFlow 策划画布",
        "selector": [
          {
            "filenamePattern": "*.gameflow.json"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.gameflow.json",
        "url": "./schemas/gameflow.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "check": "tsc --noEmit && tsc --project tsconfig.webview.json --noEmit",
    "test": "node test/run-tests.cjs",
    "test:instance-host": "node test/run-instance-host.cjs",
    "test:psd-host": "node test/run-psd-host.cjs",
    "build": "npm run check && node esbuild.js && vite build",
    "build:dev": "node esbuild.js --dev && vite build --mode development",
    "dev:webview": "vite --host 127.0.0.1",
    "watch:ext": "node esbuild.js --watch",
    "watch:webview": "vite build --watch --mode development",
    "build:distribution": "node tools/internal-extensions/build.cjs",
    "package:vsix": "node tools/internal-extensions/package.cjs gameflow",
    "package:updater": "npm run build:distribution && node tools/internal-extensions/package.cjs updater",
    "publish:internal": "node tools/internal-extensions/publish.cjs",
    "test:distribution": "node --test tools/internal-extensions/test.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "ag-psd": "34.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.16",
    "pinyin-pro": "3.29.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.105.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/vsce": "4.1.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "semver": "7.8.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "yauzl": "3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codetypess/vscode-gameflow.git"
  }
}
