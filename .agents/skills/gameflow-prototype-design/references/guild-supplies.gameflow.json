  "title": "公会物资征集",
  "requirements": [
    {
      "id": "goal",
      "text": "成员查看本周征集进度，按进行中或已完成筛选物资列表。",
      "status": "confirmed",
      "source": "示例策划 §1 征集概览"
    },
    {
      "id": "materials",
      "text": "每行展示物资名称、图标和剩余需求量。进行中的物资可发起捐献。",
      "status": "confirmed",
      "source": "示例策划 §2 物资条目"
    },
    {
      "id": "quantity",
      "text": "弹窗内可调整捐献数量，上限取剩余需求和持有量中的较小值。取消返回，确认后返回并更新征集进度。",
      "status": "confirmed",
      "source": "示例策划 §3 捐献数量"
    },
    {
      "id": "example-values",
      "text": "样例展示进行中的征集，当前进度 60/100，持有木材 12 份，本次选择 6 份。",
      "status": "inferred",
      "source": "原型演示数据，供评审布局与数值范围"
    }
